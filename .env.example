# Host-side dev (services run via tsx on the host) talk to Kafka on 9094, Postgres on 5432.
KAFKA_BROKERS=localhost:9094
DATABASE_URL=postgresql://tick:tick@localhost:5432/tick
# Price feed: 'binance' (real, no key) or 'sim' (offline random walk)
MARKET_FEED=binance
# If 5432 is taken locally, override and adjust DATABASE_URL host port.
# POSTGRES_PORT=5433
